# Base URL of the API, origin only — the client appends the /api/v1 prefix itself.
#
# Unset, the site talks to http://localhost:8080, which is where the service listens in local
# development. Its CORS allow-list already includes http://localhost:3002, so a local server works
# with no further setup.
#
# NEXT_PUBLIC_ is required: these calls are made from the browser, and Next only exposes variables
# with that prefix to client code. It is inlined at build time, so a deployment must set it before
# `next build`, not at run time.
#
# There is no deployed value to put here yet. Leave it unset for local work rather than guessing a
# hostname.
NEXT_PUBLIC_API_URL=
